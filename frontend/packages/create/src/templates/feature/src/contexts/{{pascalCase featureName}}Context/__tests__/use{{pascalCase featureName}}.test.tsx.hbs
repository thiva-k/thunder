import {describe, it, expect} from 'vitest';
import {renderHook} from '@testing-library/react';
import {{pascalCase featureName}}Provider from '../{{pascalCase featureName}}Provider';
import use{{pascalCase featureName}} from '../use{{pascalCase featureName}}';

describe('use{{pascalCase featureName}}', () => {
  it('should throw error when used outside provider', () => {
    expect(() => {
      renderHook(() => use{{pascalCase featureName}}());
    }).toThrow('use{{pascalCase featureName}} must be used within a {{pascalCase featureName}}Provider');
  });

  it('should return context value when used inside provider', () => {
    const {result} = renderHook(() => use{{pascalCase featureName}}(), {
      wrapper: {{pascalCase featureName}}Provider,
    });

    expect(result.current).toBeDefined();
    expect(result.current.isLoading).toBe(false);
    expect(result.current.error).toBeNull();
    expect(typeof result.current.refresh).toBe('function');
    expect(typeof result.current.setError).toBe('function');
  });
});
