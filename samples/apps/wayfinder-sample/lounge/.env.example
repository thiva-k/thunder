# ThunderID base URL. Must be reachable over public HTTPS, since the wallet
# calls back to it for the OpenID4VP /initiate and /status endpoints.
THUNDER_BASE_URL=https://localhost:8090

# Port the lounge kiosk serves on.
LOUNGE_PORT=8795

# Presentation definition handle to verify (must exist in ThunderID).
SKYPASS_DEFINITION_ID=wayfinder-skypass

# Tiers allowed into the lounge (comma-separated). The access decision is made
# here, after verification, on the verified tier claim.
ALLOWED_TIERS=Gold,Platinum
