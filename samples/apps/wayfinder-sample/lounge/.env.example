# Thunder base URL (the public tunnel that issued the Sky Pass). The lounge calls
# its OpenID4VP /initiate + /status endpoints; the wallet must be able to reach it.
THUNDER_BASE_URL=https://your-tunnel.trycloudflare.com

# Port the lounge kiosk serves on.
PORT=8795

# Presentation definition handle to verify (must exist in Thunder).
SKYPASS_DEFINITION_ID=wayfinder-skypass

# Tiers allowed into the lounge (comma-separated). The decision is made here,
# after verification, on the verified `tier` claim.
ALLOWED_TIERS=Gold,Platinum
