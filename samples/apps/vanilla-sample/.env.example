## ============================================================================
## Sample App Configuration (Development Only)
## ============================================================================
## Copy this file to .env.local and fill in your values. These are only read
## on the server (see src/lib/server/thunderid.ts). Next.js never bundles
## them into client-side JavaScript unless a variable is prefixed with
## NEXT_PUBLIC_, which none of these are.
## ============================================================================

# The ThunderID server this sample talks to.
# E.g., https://localhost:8090
THUNDERID_SERVER_URL=https://localhost:8090

# Application ID registered in the server for this sample (see thunderid-config/). This is the
# fixed id the declarative import creates the "Sample App" application with, so it works as-is
# once you've imported thunderid-config/basic or thunderid-config/multi-auth.
THUNDERID_APPLICATION_ID=019e3a5c-0500-7f3e-a66e-66fc7918c3a7

# Flow Secret issued to the application above. Required for this server to initiate
# authentication/sign-out flows directly via the Flow Execution API. Never exposed to the browser.
# Matches SAMPLE_APP_FLOW_SECRET's default in thunderid-config/*/thunderid.env.
THUNDERID_FLOW_SECRET=sample-app-flow-secret

# If this sample came from a packaged ThunderID distribution, it already trusts that
# distribution's own certificate (bundled at certificates/server.cert) and this can stay unset.
# From a monorepo checkout, required by default: both `make run_backend` and a server built from a
# distribution use a self-signed development certificate unless you've configured one from a
# trusted CA. Path to that certificate, so Node's fetch() trusts it.
# E.g., <repo-root>/backend/cmd/server/config/certs/server.cert
THUNDERID_SERVER_CA_CERT=
